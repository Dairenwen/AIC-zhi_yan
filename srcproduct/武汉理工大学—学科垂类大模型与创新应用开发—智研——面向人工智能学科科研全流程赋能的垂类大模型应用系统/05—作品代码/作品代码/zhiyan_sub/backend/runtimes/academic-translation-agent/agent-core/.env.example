# API mode is used for terminology, translation and submission-level wording.
TRANSLATION_LLM_BACKEND=api
TRANSLATION_API_BASE_URL=https://api.siliconflow.cn/v1
TRANSLATION_API_MODEL=deepseek-ai/DeepSeek-V4-Flash
TRANSLATION_API_KEY=
TRANSLATION_API_TIMEOUT_SECONDS=240
TRANSLATION_API_MAX_TOKENS=2048
TRANSLATION_API_RETRIES=2
TRANSLATION_API_RETRY_BACKOFF_SECONDS=2
TRANSLATION_API_DISABLE_THINKING=true
TRANSLATION_API_MAX_PARALLEL=1
# Local fallback only.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TRANSLATION_MODEL=translategemma:12b
OLLAMA_TEMPERATURE=0
OLLAMA_NUM_CTX=8192
MAX_PARALLEL_SEGMENTS=1

# Optional: enables original-layout PDF output through an existing local PDFMathTranslate install.
# macOS/Linux example: /absolute/path/PDFMathTranslate/.venv/bin/pdf2zh
# Windows example: C:/absolute/path/PDFMathTranslate/.venv/Scripts/pdf2zh.exe
PDF2ZH_COMMAND=
DEFAULT_OUTPUT_DIR=outputs
