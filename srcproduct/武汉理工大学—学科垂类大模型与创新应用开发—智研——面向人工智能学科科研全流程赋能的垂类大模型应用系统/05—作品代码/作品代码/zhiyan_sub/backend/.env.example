FLASK_ENV=development
SECRET_KEY=replace-me
DATABASE_URL=postgresql+psycopg://用户名:密码@127.0.0.1:5432/zhiyan
CORS_ORIGINS=https://zhiyan.uc1002.xyz

KNOWLEDGE_BASE_EMBEDDED=true
UPLOAD_FOLDER=/www/wwwroot/zhiyan-data/uploads
GENERATED_FOLDER=/www/wwwroot/zhiyan-data/generated
UV_CACHE_DIR=/www/wwwroot/zhiyan-data/uv-cache

# Timeout for the lightweight platform-model connection test.
MODEL_VERIFY_TIMEOUT_SECONDS=60

QWEN_DPO_BASE_URL=
QWEN_DPO_MODEL=
QWEN_DPO_API_KEY=
QWEN_DPO_TIMEOUT_SECONDS=180
QWEN_DPO_ENV_OVERRIDE=true


NORMAL_USER_FREE_TOKEN_QUOTA=1000000

USER_API_MODEL_BASE_URL=
USER_API_MODEL_NAME=
USER_API_MODEL_API_KEY=
USER_API_MODEL_TIMEOUT_SECONDS=120
USER_API_MODEL_MAX_OUTPUT_TOKENS=3072



# Bundled knowledge-base runtime. Data is stored in DATABASE_URL under this schema.
KNOWLEDGE_BASE_EMBEDDED=true
KNOWLEDGE_BASE_ROOT=knowledge_base_runtime
KB_DB_SCHEMA=knowledge_base
KB_SHARED_USER_SCHEMA=zhiyan
KB_DEFAULT_USER_ID=zhiyan
KB_DATA_DIR=infrastructure/file-storage/data
SPLITTER_API_BASE_URL=

# Optional retrieval services. Keep disabled unless the corresponding local services are running.
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_INDEX=papers_idx
ELASTICSEARCH_ENABLED=0
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_CA_CERT=
KB_MILVUS_URI=E:/kb_pdf_store/demov15_milvus/milvus_lite.db
KB_MILVUS_COLLECTION=paper_chunks_bge_m3
KB_MILVUS_DIM=1024
KB_MILVUS_ENABLED=1
# On Windows, use an absolute ASCII-only path because FAISS cannot write indexes under non-ASCII parent paths.
KB_MILVUS_URI=E:/kb_pdf_store/demov15_milvus/milvus_lite.db
KB_MILVUS_COLLECTION=paper_chunks_bge_m3
KB_MILVUS_DIM=1024
KB_MILVUS_ENABLED=0
# Knowledge-base embedding and reranking use remote HTTP APIs.
KB_EMBEDDING_BACKEND=api
KB_EMBEDDING_API_BASE_URL=
KB_EMBEDDING_API_KEY=
KB_EMBEDDING_API_MODEL=BAAI/bge-m3
KB_EMBEDDING_API_ENDPOINT=/embeddings
KB_EMBEDDING_API_TIMEOUT_SECONDS=120
KB_EMBEDDING_API_MAX_RETRIES=3
KB_RERANKER_BACKEND=api
KB_RERANKER_API_BASE_URL=
KB_RERANKER_API_KEY=
KB_RERANKER_API_MODEL=BAAI/bge-reranker-v2-m3
KB_RERANKER_API_ENDPOINT=/rerank
KB_RERANKER_API_TIMEOUT_SECONDS=120
KB_RERANKER_API_MAX_RETRIES=3
# Legacy

OLLAMA_EMBED_BASE_URL=
OLLAMA_EMBED_MODEL=bge-m3:latest
OLLAMA_EMBED_TIMEOUT_SECONDS=120
BGE_M3_MODEL=infrastructure/external-dep/runtime/models/BAAI_bge-m3
BGE_EMBED_BATCH_SIZE=16
BGE_USE_FP16=1
HF_HOME=infrastructure/external-dep/runtime/hf_cache
TRANSFORMERS_CACHE=infrastructure/external-dep/runtime/hf_cache

# QA generation model migrated from the standalone knowledge-base service.


CHUNK_QA_MODEL_BASE_URL=
CHUNK_QA_MODEL_API_KEY=
CHUNK_QA_MODEL_NAME=

CHUNK_QA_MODEL_TIMEOUT=60
CHUNK_QA_MODEL_TEMPERATURE=0.1
CHUNK_QA_MODEL_RESPONSE_FORMAT=json_object

PAPER_READING_ENABLE_DOCLING=false

TRANSLATION_OLLAMA_BASE_URL=
TRANSLATION_OLLAMA_MODEL=

SMS_PROVIDER=aliyun

ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=恒创联众
ALIYUN_SMS_TEMPLATE_CODE=100001
ALIYUN_SMS_TEMPLATE_MINUTES=5
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_SCHEME_NAME=
ALIYUN_SMS_ENDPOINT=https://dypnsapi.aliyuncs.com/
SMS_TIMEOUT_SECONDS=10
SMS_CODE_MAX_ATTEMPTS=5


# Optional absolute path to a CJK font on Linux servers, e.g. NotoSansCJK-Regular.ttc.
ACADEMIC_FIGURE_FONT_PATH=/usr/share/fonts/truetype/noto/NotoSansCJK-Regular.ttc

PAPER_READING_UV_CACHE_DIR=/www/wwwroot/zhiyan/backend/tmp/uv-paper-reading-cache

FORMULA_RECOGNITION_DEVICE=cpu
FORMULA_RECOGNITION_CPU_THREADS=1
FORMULA_RECOGNITION_TIMEOUT_SECONDS=300
FORMULA_RUNTIME_STATUS_CACHE_SECONDS=30
FORMULA_RECOGNITION_PYTHON=/www/wwwroot/zhiyan/backend/app/tools/formula_recognition/runtime/.venv/bin/python
