{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhiyan.local/contracts/reading_claim.schema.json",
  "title": "ReadingClaim",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim_id", "claim_type", "claim_source", "content", "evidence_ids"],
  "properties": {
    "schema_version": {"const": "reading_claim_v1"},
    "claim_id": {"type": "string", "minLength": 3, "maxLength": 128},
    "claim_type": {"enum": ["RESEARCH_QUESTION", "METHOD", "EQUATION_FIGURE", "EXPERIMENT", "INNOVATION", "LIMITATION", "CONSENSUS", "DIFFERENCE", "CONFLICT", "RESEARCH_GAP"]},
    "claim_source": {"enum": ["AUTHOR_STATED", "EVIDENCE_DERIVED", "AGENT_INFERRED", "CROSS_PAPER_ASSESSED"]},
    "content": {"type": "string", "minLength": 1, "maxLength": 4000},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 128}}
  }
}
