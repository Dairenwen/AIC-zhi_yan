# ===== LLM API 配置 =====
# DeepSeek（推荐）
OPENAI_API_KEY=sk-your-key-here
OPENAI_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# OpenAI
# OPENAI_API_KEY=sk-xxxx
# OPENAI_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4

# 通义千问
# OPENAI_API_KEY=sk-xxxx
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# PostgreSQL（后续接入）
# DATABASE_URL=postgresql://user:password@localhost:5432/agent_db

# ===== 文件上传配置 =====
# 单个文件大小上限（单位 MB），默认 50
MAX_UPLOAD_MB=50


# ===== 独立 Agent 服务地址（网关按 agent_id 转发） =====
# 队友的 Agent 做成独立 HTTP 服务后，把地址填在这里即可接入；留空表示「尚未接入」。
# 契约见 docs/agent-integration.md
# AGENT_DRAWING_URL=http://localhost:8010
# AGENT_INNOVATION_URL=http://localhost:8011
# AGENT_COPYRIGHT_URL=http://localhost:8012
# AGENT_PATENT_URL=http://localhost:8013
# AGENT_TRANSLATION_URL=http://localhost:8014

# 后端对外可达地址（供独立 Agent 服务回取上传的原始文件；跨机部署时改成局域网/公网地址）
BACKEND_PUBLIC_URL=http://localhost:8001