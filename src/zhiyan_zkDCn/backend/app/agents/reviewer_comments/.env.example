# =============================================================================
# langgraph-agent 运行时配置样例
# -----------------------------------------------------------------------------
# 用法：
#   cp .env.example .env
#   编辑 .env 填入真实值
# 注意：
#   - .env 含密钥，禁止提交版本库
#   - 离线验收（demo-offline / 单元测试）可不配置本文件
#   - 联机至少需要 DATABASE_URL；调用 LLM 时还需要 LLM_BASE_URL + LLM_API_KEY
# =============================================================================

# -----------------------------------------------------------------------------
# LLM（OpenAI-compatible Chat Completions）
# -----------------------------------------------------------------------------
# 端点地址，通常以 /v1 结尾。例：https://api.openai.com/v1 或自建中转站
LLM_BASE_URL=https://your-relay-station/v1
# API Key（勿提交）
LLM_API_KEY=sk-your-key-here

# split / analyze / reply 共用超时（秒）。自建慢模型/思考模式建议 180~300
LLM_TIMEOUT_SECONDS=30
# 论文语义卡片专用超时（秒）；失败会安全降级为规则卡片
PAPER_CARD_LLM_TIMEOUT_SECONDS=60

# 多条原文条目拆分时的并发 LLM 上限（默认 3；设为 1 即串行）
SPLIT_MAX_WORKERS=3
# 论文卡片子批次并发 LLM 上限（默认 5；设为 1 即串行）
PAPER_CARD_MAX_WORKERS=5
# 批量分析建议后台并行上限（默认 8；设为 1 即串行）
ANALYSIS_MAX_WORKERS=8
# 批量生成回复后台并行上限（默认 8；设为 1 即串行）
REPLY_MAX_WORKERS=8

# 可选：透传给 Chat Completions 的 extra_body（必须是 JSON 对象字符串）
# 例：关闭思考模式 → {"chat_template_kwargs":{"enable_thinking":false}}
# 服务端不认识该字段时可能忽略或报错
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# -----------------------------------------------------------------------------
# 模型分工（可按端点实际可用模型覆盖）
# -----------------------------------------------------------------------------
# 拆意见 / 分类：要求结构化输出稳定
MODEL_SPLIT=grok-4.5
# 分析意见
MODEL_ANALYZE=grok-4.5
# 论文卡片抽取；留空则回退到 MODEL_ANALYZE
MODEL_PAPER_CARD=grok-4.5
# 回复草稿
MODEL_DRAFT=grok-4.5

# -----------------------------------------------------------------------------
# PostgreSQL（业务表 + LangGraph Checkpointer 共用同一实例）
# -----------------------------------------------------------------------------
# 格式（推荐）：
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# 也接受：
#   postgresql+psycopg://...   （SQLAlchemy 风格，内部会归一化）
#   postgres://...             （旧前缀，内部会归一化）
# 代码侧：
#   settings.sqlalchemy_url() → postgresql+psycopg://...
#   settings.libpq_url()      → postgresql://...  （PostgresSaver）
#
# 示例（本地 Docker）：
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/response_agent

# -----------------------------------------------------------------------------
# 论文本地存储（慢速模式 SLOW；可选）
# -----------------------------------------------------------------------------
# 默认：langgraph-agent/.storage/manuscripts（相对本包根）
# MANUSCRIPT_STORAGE_DIR=D:/data/manuscripts
# 单文件大小上限（字节），默认 20MB = 20971520
# MANUSCRIPT_MAX_BYTES=20971520

# -----------------------------------------------------------------------------
# 导出路径说明（只读说明，无对应环境变量）
# -----------------------------------------------------------------------------
# 定稿导出文件固定写入：langgraph-agent/.tmp/finalize_exports/
# 当前代码不支持通过环境变量覆盖该路径，请勿臆造 EXPORT_* 变量。
